<UserControl x:Class="CreatorCoffinTracker.ScrollingIconsBgComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CreatorCoffinTracker"
             mc:Ignorable="d" UseLayoutRounding="True"
             d:DesignHeight="1500" d:DesignWidth="2012">
    <Viewbox Stretch="Uniform">
        <Canvas Width="2012" Height="1500">
            <Image x:Name="BasicImage" CacheMode="BitmapCache"
                   Source="/Media/Bgr Icons.png"
                   Stretch="Uniform"
                   Opacity="0.1"
                   Canvas.Bottom="0"/>
        </Canvas>
    </Viewbox>
    <UserControl.Resources>
        <Storyboard x:Key="BasicTheme" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="BasicImage"
                Storyboard.TargetProperty="(Canvas.Bottom)"
                From="0"
                To="200"
                Duration="0:00:09"/>
        </Storyboard>
    </UserControl.Resources>
</UserControl>
