<Window x:Class="CreatorCoffinTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Local="clr-namespace:CreatorCoffinTracker"
        mc:Ignorable="d"
        Title="COFFIN_TRACKER_PROGRAM" Height="720" Width="1360" MinWidth="1360" MinHeight="720" ResizeMode="CanMinimize" CacheMode="BitmapCache">
    <Window.Background>
        <ImageBrush ImageSource="Media/Bgr.png"/>
    </Window.Background>
    <Grid ClipToBounds="True">
        <Local:ScrollingIconsBgComponent RenderTransformOrigin="0.5,0.5">
            <Local:ScrollingIconsBgComponent.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="2.75" ScaleY="2.75"/>
                    <SkewTransform/>
                    <RotateTransform Angle="8"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Local:ScrollingIconsBgComponent.RenderTransform>
        </Local:ScrollingIconsBgComponent>

        <Grid x:Name="CreatorCodeEntryScreen">
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="CreatorCodeEntryHeader" Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Local:OutlinedTextBlock Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="10,0" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="3.5" ShadowColor="Black" ShadowOffset="0,2.5"
                                         Text="CREATOR CODE"/>

                <DockPanel Grid.Column="1" Margin="10,0">
                    <Image Source="Media/Textbox Area Leftslice.png" DockPanel.Dock="Left" Stretch="Uniform" CacheMode="BitmapCache"/>
                    <Image Source="Media/Textbox Area Rightslice.png" DockPanel.Dock="Right" Stretch="Uniform" CacheMode="BitmapCache"/>
                    <TextBox x:Name="TxtField_CreatorCodeInput" TextAlignment="Center" MaxLength="20" Margin="-1,0"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                         FontSize="36" BorderThickness="0" CacheMode="BitmapCache"
                         FontFamily="./Media/#Lilita One" MaxLines="1">
                        <TextBox.Background>
                            <ImageBrush ImageSource="Media/Textbox Area Midslice.png"/>
                        </TextBox.Background>
                    </TextBox>
                </DockPanel>

                <DockPanel Grid.Column="3" LastChildFill="False">
                    <Local:SpriteButton x:Name="BTN_Fetch" SpriteSource="/Media/Blue Button Long.png" CacheMode="BitmapCache"
                                    SpriteStretch="Uniform" HorizontalAlignment="Left" Click="BTN_Fetch_Click">
                        <Local:OutlinedTextBlock VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,3" CacheMode="BitmapCache"
                                 FontFamily="./Media/#Lilita One" StrokeThiccness="3.5" ShadowColor="Black" ShadowOffset="0,2.5"
                                 Text="Fetch!!!"/>
                    </Local:SpriteButton>

                    <Local:SpriteButton x:Name="BTN_ClearData" SpriteSource="/Media/Red Button.png" Margin="6,0,0,0"
                                    SpriteStretch="Uniform" HorizontalAlignment="Left" Click="BTN_ClearData_Click">
                        <Local:OutlinedTextBlock VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,3" CacheMode="BitmapCache"
                                 FontFamily="./Media/#Lilita One" StrokeThiccness="3.5" ShadowColor="Black" ShadowOffset="0,2.5"
                                 Text="Reset"/>
                    </Local:SpriteButton>
                </DockPanel>
            </Grid>

            <Grid x:Name="CreatorCodeData" Grid.Row="2" Margin="10">
                <Local:OutlinedTextBlock x:Name="CreatorCodeDataNotFoundYet" Visibility="Visible"
                    Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="10,0" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="3.5" ShadowColor="Black" ShadowOffset="0,2.5"
                                         Text="Enter a valid creator code on the textfield above and press Fetch to start!"/>
                <Grid x:Name="CreatorCodeDataDisplay" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3.5*"/>
                        <RowDefinition Height="1.8*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Local:OutlinedTextBlock Grid.Row="0" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Center" Margin="10,5" Fill="LightGray" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="3.5" ShadowColor="Black" ShadowOffset="0,2.5"
                                         Text="Now following"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.4*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.4*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="0" Grid.RowSpan="3">
                            <Rectangle RadiusX="60" RadiusY="60" Stretch="Uniform" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="96" MinHeight="96" CacheMode="BitmapCache"
                                       Stroke="Black" StrokeThickness="4">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="CreatorPFP" Stretch="Uniform" ImageSource="/Media/NAILS.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <Local:OutlinedTextBlock x:Name="CreatorName" Grid.Column="1" Grid.Row="0" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Left" Margin="10,0" Fill="White"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="4" ShadowColor="Black" ShadowOffset="0,3.25" FontSize="48" CacheMode="BitmapCache"
                                         Text="Bepis"/>
                        <Local:OutlinedTextBlock x:Name="CreatorTeamScore" Grid.Column="1" Grid.Row="1" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" Margin="10,0" Fill="LightGray"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="3" ShadowColor="Black" ShadowOffset="0,2.5" FontSize="32" CacheMode="BitmapCache"
                                         Text="with 1,234,567 players"/>

                        <Local:SpriteButton x:Name="BTN_GoToChannel" Grid.Column="2" Grid.Row="0" SpriteSource="/Media/Blue Button Long.png" CacheMode="BitmapCache"
                                    SpriteStretch="Uniform" HorizontalAlignment="Center" Click="BTN_GoToChannel_Click">
                            <Local:OutlinedTextBlock VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,3" FontSize="26" CacheMode="BitmapCache"
                                 FontFamily="./Media/#Lilita One" StrokeThiccness="3" ShadowColor="Black" ShadowOffset="0,2.25"
                                 Text="GO TO CHANNEL"/>
                        </Local:SpriteButton>

                        <Local:OutlinedTextBlock x:Name="CreatorHandle" Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Top" HorizontalContentAlignment="Center" Margin="10,0" Fill="LightGray"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="2.75" ShadowColor="Black" ShadowOffset="0,2.25" FontSize="28" CacheMode="BitmapCache"
                                         Text="@idontknow"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Local:OutlinedTextBlock x:Name="CreatorProgressValue" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Center" Margin="10,0,10,46" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="8" ShadowColor="Black" ShadowOffset="0,6.5" FontSize="128"
                                         Text="0,000,000,000,000"/>
                        <Local:OutlinedTextBlock VerticalContentAlignment="Bottom" HorizontalContentAlignment="Center" Margin="10,10" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="3.75" ShadowColor="Black" ShadowOffset="0,3" FontSize="42"
                                         Text="event progress points"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="10,0">
                        <ProgressBar x:Name="CreatorProgress" Margin="0,0" VerticalAlignment="Top" CacheMode="BitmapCache"
                                 Maximum="100" Value="3"
                                 Style="{StaticResource SlicedProgressBarStyle}"/>
                        <Canvas x:Name="CreatorProgressIndicators" Height="98" VerticalAlignment="Top"
                                IsHitTestVisible="False" Panel.ZIndex="1"
                                SizeChanged="CreatorProgressIndicators_SizeChanged"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Local:SpriteButton x:Name="BTN_PageLeft" Grid.Column="0" SpriteSource="Media/Arrow Left.png" CacheMode="BitmapCache"
                                    SpriteStretch="Uniform" HorizontalAlignment="Right" Click="BTN_PageLeft_Click">
                        </Local:SpriteButton>

                        <Local:SpriteButton x:Name="BTN_PageRight" Grid.Column="2" SpriteSource="Media/Arrow Right.png" CacheMode="BitmapCache"
                                    SpriteStretch="Uniform" HorizontalAlignment="Left" Click="BTN_PageRight_Click">
                        </Local:SpriteButton>

                        <Local:OutlinedTextBlock x:Name="CreatorDayX" Grid.Column="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="10,0" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="4" ShadowColor="Black" ShadowOffset="0,3.25" FontSize="48"
                                         Text="Day 1/2"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Rectangle HorizontalAlignment="Stretch" Height="34" Stroke="Black" Fill="Black" VerticalAlignment="Top"/>
            <Local:OutlinedTextBlock HorizontalContentAlignment="Center" Margin="10,8" FontSize="42" CacheMode="BitmapCache"
                                         FontFamily="./Media/#Lilita One" StrokeThiccness="3.5" ShadowColor="Black" ShadowOffset="0,2.5"
                                         Text="CREATOR COFFIN PROGRESS FETCHER"/>
        </Grid>
    </Grid>
</Window>
